      "verification_query": "select to_regclass('public.poker_sessions') is not null and to_regclass('public.dino_run_sessions') is not null and to_regclass('private.coin_flip_prank_settings') is not null and to_regclass('private.game_prank_settings') is not null and to_regclass('private.dino_game_settings') is not null and to_regprocedure('public.admin_coin_stats()') is not null and to_regprocedure('public.admin_reset_coin_stats(text)') is not null and to_regprocedure('public.start_poker(bigint)') is not null and to_regprocedure('public.start_dino_run()') is not null and to_regprocedure('public.get_game_extras_admin_state()') is not null and position('values (new.id, 10)' in lower(pg_get_functiondef('private.handle_new_user()'::regprocedure))) > 0 and position('unique_violation' in pg_get_functiondef('private.handle_new_user()'::regprocedure)) > 0 and exists(select 1 from public.game_settings where game_key='plinko') and exists(select 1 from pg_constraint where conrelid='public.game_rounds'::regclass and conname='game_rounds_wager_check' and pg_get_constraintdef(oid)='CHECK ((wager >= 0))') and exists(select 1 from pg_constraint where conrelid='public.game_rounds'::regclass and conname='game_rounds_payout_check' and pg_get_constraintdef(oid)='CHECK ((payout >= 0))') and exists(select 1 from pg_constraint where conrelid='public.dino_run_sessions'::regclass and conname='dino_run_sessions_wager_check' and pg_get_constraintdef(oid) like '%150%') and exists(select 1 from pg_constraint where conrelid='public.game_settings'::regclass and conname='game_settings_game_key_check' and pg_get_constraintdef(oid) like '%crash%') as verified;"
